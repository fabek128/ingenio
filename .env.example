# Copiar a .env para desarrollo local.
# No commitear valores reales ni secretos.

INGENIO_ENV=development
INGENIO_API_HOST=127.0.0.1
INGENIO_API_PORT=8080
INGENIO_ALLOWED_ORIGIN=http://localhost:8000

INGENIO_LLM_BASE_URL=https://opencode.ai/zen/v1
INGENIO_LLM_MODEL=deepseek-v4-flash-free
INGENIO_LLM_API_KEY=
INGENIO_LLM_TIMEOUT_SECONDS=45
INGENIO_LLM_MAX_TOKENS=2048

# Generar localmente con: openssl rand -hex 32
INGENIO_SESSION_SECRET=
INGENIO_SESSION_TTL_SECONDS=3600
INGENIO_RATE_LIMIT_PER_MINUTE=12
INGENIO_MAX_MESSAGE_CHARS=2000

# Logs de interacciones del agente.
# Se emiten como JSON a stdout para ingestion via Promtail/Loki.
# El texto se guarda con redaccion de secretos; no desactivar salvo necesidad justificada.
INGENIO_CHAT_LOG_ENABLED=true
INGENIO_CHAT_LOG_INCLUDE_TEXT=true

# Formato de logs para stdout (text|json). Usar 'json' si Promtail/Loki recolecta los logs.
LOG_FORMAT=json
LOG_LEVEL=INFO

# Configuracion de email para formulario de contacto (Resend)
# RESEND_API_KEY: obtener en https://resend.com/api-keys
# RESEND_FROM_EMAIL: debe ser un dominio verificado en Resend (ej: contacto@tudominio.com)
# CONTACT_RECIPIENT_EMAIL: email donde llegarán las consultas del formulario
RESEND_API_KEY=
RESEND_FROM_EMAIL=contacto@ingenio64.com
CONTACT_RECIPIENT_EMAIL=

# Frontend publico: velocidad del tipeo de respuestas del agente, en ms por caracter.
INGENIO_RESPONSE_TYPE_SPEED_MS=6

# Deploy / infraestructura (placeholders; no commitear valores reales)
DOMAIN_INGENIO=
DOMAIN_NPM=
DOMAIN_DOKPLOY=
DOMAIN_ARCHIVOS=
GRAFANA_DOMAIN=

VPS_HOST=
VPS_IP=
VPS_USER=
VPS_PORT=22
VPS_ZT_IP=

LOCAL_HOST=
LOCAL_USER=
LOCAL_SERVER_IP=
LOCAL_ZT_IP=

NPM_UI_URL=
NPM_USER=

DOKPLOY_API_URL=
DOKPLOY_API_TOKEN=
DOKPLOY_PROJECT_ID=
DOKPLOY_SERVICE_ID=
DOKPLOY_APPLICATION_ID=
DOKPLOY_COMPOSE_ID=
DOKPLOY_DEPLOY_WEBHOOK_URL=

RUSTFS_ENDPOINT=
RUSTFS_CONSOLE_URL=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

GRAFANA_USER=
SMOKE_TEST_URL=
